DY/AI/", "title": "AI \uc804\uccb4 \ubcf4\uae30", "content_html": "<!-- AUTO-SECTION-INDEX: tools/section_index.py \uac00 \ube4c\ub4dc\ub9c8\ub2e4 \ub2e4\uc2dc \ub9cc\ub4e0\ub2e4. \uc9c1\uc811 \uace0\uce58\uc9c0 \ub9d0 \uac83. -->\n\n<h1>AI \uc804\uccb4 \ubcf4\uae30</h1>\n<p>Claude\u00b7Gemini\u00b7GPT \uac19\uc740 \ubaa8\ub378\uacfc Claude Code\u00b7Cursor \uac19\uc740 \ub3c4\uad6c, \uadf8\ub9ac\uace0 LLM\u00b7RAG\u00b7MC...</p>", "image": null, "date_modified": "2026-08-18T09:28:07.463538+00:00", "date_published": "2026-08-18T09:28:07.463532+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/%EC%B5%9C%EA%B7%BC/", "url": "https://gyutory.github.io/YGSTUDY/%EC%B5%9C%EA%B7%BC/", "title": "\ucd5c\uadfc \ubcc0\uacbd \ubb38\uc11c", "content_html": "<h1>\ucd5c\uadfc \ubcc0\uacbd \ubb38\uc11c</h1>\n<p>\ucd5c\uadfc 60\uc77c \ub0b4 \ucd94\uac00\u00b7\uc218\uc815\ub41c \ubb38\uc11c\uc785\ub2c8\ub2e4. \ube4c\ub4dc \uc2dc\uc810\uc5d0 \uc790\ub3d9 \uc0dd\uc131\ub429\ub2c8\ub2e4.</p>\n<p>| \ub0a0\uc9dc | \ubb38\uc11c |\n|------|------|\n| 2026-08-18 | <a href=\"Backend/API/API_Caching.md\">API \uce90\uc2f1 (HTTP Caching)</a> |\n| 2026-...</p>", "image": null, "date_modified": "2026-08-18T09:28:07.433611+00:00", "date_published": "2026-08-18T09:28:07.433604+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Architecture/MSA/%EB%B6%84%EC%82%B0_%EC%BA%90%EC%8B%B1_%ED%8C%A8%ED%84%B4/", "url": "https://gyutory.github.io/YGSTUDY/Architecture/MSA/%EB%B6%84%EC%82%B0_%EC%BA%90%EC%8B%B1_%ED%8C%A8%ED%84%B4/", "title": "\ubd84\uc0b0 \uce90\uc2f1 \ud328\ud134", "content_html": "<h1>\ubd84\uc0b0 \uce90\uc2f1 \ud328\ud134</h1>\n<h2>MSA\uc5d0\uc11c \uce90\uc2f1\uc774 \ubcf5\uc7a1\ud574\uc9c0\ub294 \uc774\uc720</h2>\n<p>\ubaa8\ub180\ub9ac\uc2a4\uc5d0\uc11c\ub294 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ub808\ubca8 \uce90\uc2dc \ud558\ub098\ub85c \ucda9\ubd84\ud588\ub2e4. HashMap\uc774\ub098 Ehcache \uac19\uc740 \ub85c\uceec \uce90\uc2dc\ub97c \uc4f0\uba74 \ub410\uace0, \uce90\uc2dc \ubb34\ud6a8\ud654\ub3c4 \uac19\uc740 \ud504\ub85c\uc138\uc2a4 \uc548\uc5d0\uc11c \uc77c\uc5b4\ub098\ub2c8\uae4c \ub2e8\uc21c\ud588\ub2e4.</p>\n<p>MSA\ub85c \ub118\uc5b4\uac00\uba74 \uc0c1\ud669\uc774 \ub2ec\ub77c\uc9c4\ub2e4. \uc8fc\ubb38 ...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/API/API_Caching/", "url": "https://gyutory.github.io/YGSTUDY/Backend/API/API_Caching/", "title": "\uce90\uc2f1 (HTTP Caching)", "content_html": "<h1>API \uce90\uc2f1 (HTTP Caching)</h1>\n<h2>\uac1c\uc694</h2>\n<p>API \uc751\ub2f5\uc744 \ub9e4\ubc88 \uc11c\ubc84\uc5d0\uc11c \uc0c8\ub85c \ub9cc\ub4e4 \ud544\uc694\ub294 \uc5c6\ub2e4. \uac19\uc740 \ub370\uc774\ud130\ub97c \ubc18\ubcf5\ud574\uc11c \uc694\uccad\ud558\ub294 \ud074\ub77c\uc774\uc5b8\ud2b8\uac00 \ub9ce\uace0, \ub370\uc774\ud130\uac00 \uc790\uc8fc \ubc14\ub00c\uc9c0 \uc54a\ub294 \uacbd\uc6b0\ub77c\uba74 \uce90\uc2f1\uc73c\ub85c \uc11c\ubc84 \ubd80\ud558\ub97c \uc904\uc774\uace0 \uc751\ub2f5 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud560 \uc218 \uc788\ub2e4.</p>\n<p>HTTP \uce90\uc2f1\uc740 \ud06c\uac8c ...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Authentication/Refresh_Token_Rotation/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Authentication/Refresh_Token_Rotation/", "title": "Refresh Token Rotation", "content_html": "<h1>Refresh Token Rotation</h1>\n<p>Refresh Token\uc744 \uc4f8 \ub54c\ub9c8\ub2e4 \uc0c8 \ud1a0\ud070\uc744 \ubc1c\uae09\ud558\uace0 \uc774\uc804 \ud1a0\ud070\uc744 \ud3d0\uae30\ud558\ub294 \ud328\ud134\uc774\ub2e4. \ub2e8\uc21c \ub9cc\ub8cc \ubc29\uc2dd\uacfc \ub2ec\ub9ac \ud1a0\ud070 \uc7ac\uc0ac\uc6a9 \uc5ec\ubd80\ub97c \ucd94\uc801\ud558\uae30 \ub54c\ubb38\uc5d0, \ud0c8\ucde8\ub41c \ud1a0\ud070\uc774 \uc0ac\uc6a9\ub418\ub294 \uc21c\uac04 \uac10\uc9c0\ud560 \uc218 \uc788\ub2e4.</p>\n<h2>\ub2e8\uc21c \ub9cc\ub8cc \ubc29\uc2dd\uacfc\uc758 \ucc28\uc774</h2>\n<p>\ub2e8\uc21c...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-08-01T13:14:26+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Caching/Cache_Warming/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Caching/Cache_Warming/", "title": "Cache Warming", "content_html": "<h1>\uce90\uc2dc \uc6cc\ubc0d</h1>\n<p>\uce90\uc2dc \uc6cc\ubc0d\uc740 \uc11c\ubc84\uac00 \ud2b8\ub798\ud53d\uc744 \ubc1b\uae30 \uc804\uc5d0 \uce90\uc2dc\ub97c \ubbf8\ub9ac \ucc44\uc6b0\ub294 \uc791\uc5c5\uc774\ub2e4. \ubc30\ud3ec \uc9c1\ud6c4 \ube48 \uce90\uc2dc \uc0c1\ud0dc\uc5d0\uc11c \uc694\uccad\uc774 \ub4e4\uc5b4\uc624\uba74 \ubaa8\ub4e0 \ucffc\ub9ac\uac00 DB\ub85c \uc9c1\uc811 \ub5a8\uc5b4\uc9c4\ub2e4. \uc774 \uad6c\uac04\uc744 Cold Start\ub77c\uace0 \ubd80\ub978\ub2e4.</p>\n<h2>Cold Start \ubb38\uc81c</h2>\n<p>\uc0c8 \uc11c\ubc84 \uc778\uc2a4\ud134\uc2a4\uac00 \ub728\uac70\ub098 Redis\uac00...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-07-29T13:13:03+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Tools/Semble/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Tools/Semble/", "title": "Semble", "content_html": "<h1>Semble</h1>\n<h2>\uac1c\uc694</h2>\n<p>Semble\uc740 \uc601\uad6d\uc5d0\uc11c \uc2dc\uc791\ub41c \ud074\ub77c\uc6b0\ub4dc \uae30\ubc18 \uc9c4\ub8cc \uad00\ub9ac(EHR + Practice Management) SaaS\ub2e4. \ud658\uc790 \uae30\ub85d, \uc608\uc57d, \uccad\uad6c, \ucc98\ubc29, \ud658\uc790 \ud3ec\ud138 \uac19\uc740 \uae30\ub2a5\uc744 \ud55c \uacf3\uc5d0\uc11c \uad00\ub9ac\ud55c\ub2e4. \ubc31\uc5d4\ub4dc \uac1c\ubc1c\uc790 \uc785\uc7a5\uc5d0\uc11c \uc758\ubbf8 \uc788\ub294 \ubd80\ubd84\uc740 **Public...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/DevOps/Linux/%ED%94%84%EB%A1%9C%EC%84%B8%EC%8A%A4/%EC%9E%91%EC%97%85_%EC%8A%A4%EC%BC%80%EC%A4%84%EB%A7%81/", "url": "https://gyutory.github.io/YGSTUDY/DevOps/Linux/%ED%94%84%EB%A1%9C%EC%84%B8%EC%8A%A4/%EC%9E%91%EC%97%85_%EC%8A%A4%EC%BC%80%EC%A4%84%EB%A7%81/", "title": "\uc791\uc5c5 \uc2a4\ucf00\uc904\ub9c1", "content_html": "<h1>\uc791\uc5c5 \uc2a4\ucf00\uc904\ub9c1</h1>\n<h2>\uac1c\uc694</h2>\n<p>\ub9ac\ub205\uc2a4\uc5d0\uc11c \uc791\uc5c5\uc744 \uc790\ub3d9\uc73c\ub85c \uc2e4\ud589\ud558\ub294 \ubc29\ubc95\uc740 \ud06c\uac8c \uc138 \uac00\uc9c0\ub2e4. \ubc18\ubcf5 \uc791\uc5c5\uc740 cron, \uc77c\ud68c\uc131 \uc791\uc5c5\uc740 at, systemd \ud658\uacbd\uc774\ub77c\uba74 systemd timer\ub97c \uc4f4\ub2e4. \ub370\uc2a4\ud06c\ud1b1\uc774\ub098 \ub178\ud2b8\ubd81\ucc98\ub7fc \ud56d\uc0c1 \ucf1c\uc838 \uc788\uc9c0 \uc54a\uc740 \uc2dc\uc2a4\ud15c\uc5d0\uc11c\ub294 anacron\uc774 \ucd94\uac00\ub85c \ud544\uc694...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-08-05T04:30:32+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Network/7%20Layer/Application%20Layer/Http/%EB%8C%80%EB%9F%89%EC%9D%98%20API%EB%A5%BC%20%EC%B2%98%EB%A6%AC%ED%95%98%EB%8A%94%20%EB%B0%A9%EB%B2%95/", "url": "https://gyutory.github.io/YGSTUDY/Network/7%20Layer/Application%20Layer/Http/%EB%8C%80%EB%9F%89%EC%9D%98%20API%EB%A5%BC%20%EC%B2%98%EB%A6%AC%ED%95%98%EB%8A%94%20%EB%B0%A9%EB%B2%95/", "title": "\ub300\ub7c9\uc758 API\ub97c \ucc98\ub9ac\ud558\ub294 \ubc29\ubc95", "content_html": "<h1>\ub300\ub7c9\uc758 API\ub97c \ucc98\ub9ac\ud558\ub294 \ubc29\ubc95</h1>\n<h2>\ubc30\uacbd</h2>\n<p>\ud604\ub300\uc758 \uc6f9 \uc11c\ube44\uc2a4\ub294 \ucd08\ub2f9 \uc218\ub9cc, \uc218\uc2ed\ub9cc \uac74\uc758 API \uc694\uccad\uc744 \ucc98\ub9ac\ud574\uc57c \ud558\ub294 \uc0c1\ud669\uc5d0 \uc9c1\uba74\ud55c\ub2e4.</p>\n<h3>\uc2e4\uc81c \uc0ac\ub840</h3>\n<p>| \uc11c\ube44\uc2a4 \uc720\ud615 | \ucc98\ub9ac \uaddc\ubaa8 | \uc8fc\uc694 \ub3c4\uc804 \uacfc\uc81c |\n|------------|----------|------------...</p>", "image": null, "date_modified": "2026-08-18T09:09:15+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Database/ElastiCache/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Database/ElastiCache/", "title": "AWS ElastiCache", "content_html": "<h1>AWS ElastiCache</h1>\n<h2>\uac1c\uc694</h2>\n<p>ElastiCache\ub294 \uc778\uba54\ubaa8\ub9ac \uce90\uc2dc \uc11c\ube44\uc2a4\ub2e4. Redis\uc640 Memcached \ub450 \uac00\uc9c0 \uc5d4\uc9c4\uc744 \uc9c0\uc6d0\ud55c\ub2e4. \ub370\uc774\ud130\ub97c \uba54\ubaa8\ub9ac\uc5d0 \uc800\uc7a5\ud574\uc11c \ubc00\ub9ac\ucd08 \ubbf8\ub9cc\uc758 \uc751\ub2f5 \uc18d\ub3c4\ub97c \uc81c\uacf5\ud55c\ub2e4. \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ubd80\ud558\ub97c \uc904\uc774\uace0 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc131\ub2a5\uc744 \ub192\uc778\ub2e4.</p>\n<h3>...</h3>", "image": null, "date_modified": "2026-08-18T08:53:03+00:00", "date_published": "2026-08-05T04:30:32+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/_hub/%EC%BA%90%EC%8B%B1/", "url": "https://gyutory.github.io/YGSTUDY/_hub/%EC%BA%90%EC%8B%B1/", "title": "\uce90\uc2f1", "content_html": "<h1>\uce90\uc2f1 \ud5c8\ube0c</h1>\n<h2>\uc774 \uc8fc\uc81c\ub97c \uc5b8\uc81c \ucc3e\uac8c \ub418\ub294\uac00</h2>\n<ul>\n<li>\ub3d9\uc77c \ub370\uc774\ud130\ub97c \ubc18\ubcf5 \uc870\ud68c\ud558\ub294 DB \ubd80\ud558\ub97c \uc904\uc774\uae30 \uc704\ud574 \uce90\uc2dc \ub808\uc774\uc5b4\ub97c \ucc98\uc74c \ub3c4\uc785\ud560 \ub54c</li>\n<li>\uce90\uc2dc\uc640 DB \uc0ac\uc774\uc758 \ub370\uc774\ud130 \ubd88\uc77c\uce58(Cache Invalidation) \ubb38\uc81c\ub97c \ud574\uacb0\ud574\uc57c \ud560 \ub54c</li>\n<li>Redis\ub97c \uce90\uc2dc\ub85c \uc4f8 \ub54c TTL\u00b7Evic...</l