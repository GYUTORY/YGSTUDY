774 \uc8fc\uc81c\ub294 \ub9b4\ub9ac\uc2a4 \uc8fc\uae30\uac00 \ube60\ub985\ub2c8\ub2e4. \ucd5c\uc885 \ud655\uc778: **&lt;span class=\"git-revision-date-localized-plugin git-revision-date-localized-plugin-date\" title=\"2026...</p>", "image": null, "date_modified": "2026-10-19T13:49:04+00:00", "date_published": "2026-07-25T11:17:30+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Scaling_Laws/", "url": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Scaling_Laws/", "title": "\uc2a4\ucf00\uc77c\ub9c1 \ubc95\uce59", "content_html": "<p>!!! warning \"\ube60\ub974\uac8c \ub0a1\ub294 \ubb38\uc11c\"\n    \uc774 \uc8fc\uc81c\ub294 \ub9b4\ub9ac\uc2a4 \uc8fc\uae30\uac00 \ube60\ub985\ub2c8\ub2e4. \ucd5c\uc885 \ud655\uc778: **&lt;span class=\"git-revision-date-localized-plugin git-revision-date-localized-plugin-date\" title=\"2026...</p>", "image": null, "date_modified": "2026-10-19T13:49:04+00:00", "date_published": "2026-07-25T11:17:30+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Fine_Tuning/", "url": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Fine_Tuning/", "title": "\ud30c\uc778\ud29c\ub2dd \uc2e4\ubb34", "content_html": "<p>!!! warning \"\ube60\ub974\uac8c \ub0a1\ub294 \ubb38\uc11c\"\n    \uc774 \uc8fc\uc81c\ub294 \ub9b4\ub9ac\uc2a4 \uc8fc\uae30\uac00 \ube60\ub985\ub2c8\ub2e4. \ucd5c\uc885 \ud655\uc778: **&lt;span class=\"git-revision-date-localized-plugin git-revision-date-localized-plugin-date\" title=\"2026...</p>", "image": null, "date_modified": "2026-10-19T13:09:32+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Tokenizer/", "url": "https://gyutory.github.io/YGSTUDY/AI/Concepts/LLM_Tokenizer/", "title": "\ud1a0\ud06c\ub098\uc774\uc800", "content_html": "<p>!!! warning \"\ube60\ub974\uac8c \ub0a1\ub294 \ubb38\uc11c\"\n    \uc774 \uc8fc\uc81c\ub294 \ub9b4\ub9ac\uc2a4 \uc8fc\uae30\uac00 \ube60\ub985\ub2c8\ub2e4. \ucd5c\uc885 \ud655\uc778: **&lt;span class=\"git-revision-date-localized-plugin git-revision-date-localized-plugin-date\" title=\"2026...</p>", "image": null, "date_modified": "2026-10-19T12:34:24+00:00", "date_published": "2026-07-25T11:17:30+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Messaging/RabbitMQ_MQTT/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Messaging/RabbitMQ_MQTT/", "title": "RabbitMQ MQTT Plugin", "content_html": "<h1>RabbitMQ MQTT Plugin</h1>\n<p>RabbitMQ\ub294 <code>rabbitmq_mqtt</code> \ud50c\ub7ec\uadf8\uc778\uc73c\ub85c MQTT \ube0c\ub85c\ucee4 \uc5ed\ud560\uc744 \ud55c\ub2e4. Mosquitto \uac19\uc740 \ube0c\ub85c\ucee4\ub97c \ub530\ub85c \ub450\uc9c0 \uc54a\uace0, \ub514\ubc14\uc774\uc2a4\uac00 MQTT\ub85c \ubc1c\ud589\ud55c \uba54\uc2dc\uc9c0\ub97c AMQP \ucee8\uc288\uba38\uac00 \uadf8\ub300\ub85c \ubc1b\uac8c \ub9cc\ub4dc\ub294 \uad6c\uc131\uc774\ub2e4.</p>\n<p>\uc774 \ubb38\uc11c\uc758 ...</p>", "image": null, "date_modified": "2026-10-19T11:36:32+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ/", "title": "Amazon MQ \uc6b4\uc601 \ub178\ud2b8", "content_html": "<h1>Amazon MQ \uc6b4\uc601 \ub178\ud2b8</h1>\n<p>Amazon MQ\ub294 RabbitMQ\uc640 ActiveMQ\ub97c \uad00\ub9ac\ud615\uc73c\ub85c \ub3cc\ub824\uc8fc\ub294 \uc11c\ube44\uc2a4\ub2e4. \ube0c\ub85c\ucee4 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc790\uccb4\ub294 \uc624\ud508\uc18c\uc2a4 \uadf8\ub300\ub85c\uace0, AWS\uac00 EC2 \uc778\uc2a4\ud134\uc2a4 \ud504\ub85c\ube44\uc800\ub2dd, \ud328\uce58, \ubc31\uc5c5, \uc7a5\uc560 \uc870\uce58\ub97c \ub300\uc2e0 \ud574\uc900\ub2e4. SQS/SNS\ucc98\ub7fc AWS \uc790\uccb4 \ud504\ub85c\ud1a0\ucf5c...</p>", "image": null, "date_modified": "2026-10-19T11:36:32+00:00", "date_published": "2026-08-05T04:30:32+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Messaging/Rabbit_MQ/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Messaging/Rabbit_MQ/", "title": "RabbitMQ \uc2ec\ud654", "content_html": "<h1>RabbitMQ \uc2ec\ud654</h1>\n<p>RabbitMQ\ub294 AMQP 0-9-1 \ud504\ub85c\ud1a0\ucf5c \uae30\ubc18\uc758 \uba54\uc2dc\uc9c0 \ube0c\ub85c\ucee4\ub2e4. Kafka\uc640 \ub2ec\ub9ac \uba54\uc2dc\uc9c0\ub97c Consumer\uac00 \ucc98\ub9ac\ud558\uba74 \ud050\uc5d0\uc11c \uc81c\uac70\ud558\ub294 \uc804\ud1b5\uc801\uc778 \uba54\uc2dc\uc9c0 \ud050 \ubaa8\ub378\uc774\ub2e4. \uc774 \ubb38\uc11c\ub294 RabbitMQ\ub97c \uc6b4\uc601 \uc218\uc900\uc5d0\uc11c \ub2e4\ub8e8\uae30 \uc704\ud574 \ud544\uc694\ud55c \ub0b4\uc6a9\uc744 \uc815\ub9ac\ud55c\ub2e4.</p>\n<p>...</p>", "image": null, "date_modified": "2026-10-19T10:54:25+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}]}