Mode)</h1>\n<h2>\ubaa9\ucc28</h2>\n<ul>\n<li><a href=\"#\uac1c\ub150-\uc774\ud574\">\uac1c\ub150 \uc774\ud574</a></li>\n<li><a href=\"#\uae30\ubcf8-\uc0ac\uc6a9\ubc95\">\uae30\ubcf8 \uc0ac\uc6a9\ubc95</a></li>\n<li><a href=\"#\uc124\uc815-\ud30c\uc77c-\ud65c\uc6a9\">\uc124\uc815 \ud30c\uc77c \ud65c\uc6a9</a></li>\n<li><a href=\"#\uc8fc\uc694-\uba85\ub839\uc5b4\">\uc8fc\uc694 \uba85\ub839\uc5b4</a></li>\n<li><a href=\"#\ubaa8\ub2c8\ud130\ub9c1-\ubc0f-\uad00\ub9ac\">\ubaa8\ub2c8\ud130\ub9c1 \ubc0f \uad00\ub9ac</a></li>\n<li>[\ub3d9\uc791 \uc6d0\ub9ac](#\ub3d9\uc791...</li>\n</ul>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/01_%EA%B8%B0%EB%B3%B8_JavaScript/function/%EC%9D%BC%EB%B0%98%20%ED%95%A8%EC%88%98%EC%99%80%20Arrow%20%ED%95%A8%EC%88%98/", "url": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/01_%EA%B8%B0%EB%B3%B8_JavaScript/function/%EC%9D%BC%EB%B0%98%20%ED%95%A8%EC%88%98%EC%99%80%20Arrow%20%ED%95%A8%EC%88%98/", "title": "JavaScript \uc77c\ubc18 \ud568\uc218\uc640 \ud654\uc0b4\ud45c \ud568\uc218 \ube44\uad50", "content_html": "<h1>JavaScript \uc77c\ubc18 \ud568\uc218\uc640 \ud654\uc0b4\ud45c \ud568\uc218 \ube44\uad50</h1>\n<h2>\ubc30\uacbd</h2>\n<p>JavaScript\uc5d0\uc11c \ud568\uc218\ub97c \uc815\uc758\ud558\ub294 \ubc29\ubc95\uc740 \ud06c\uac8c \ub450 \uac00\uc9c0\ub2e4. \uc77c\ubc18 \ud568\uc218\uc640 \ud654\uc0b4\ud45c \ud568\uc218. \ubb38\ubc95\uc774 \uc870\uae08 \ub2e4\ub978 \uc815\ub3c4\ub85c \ubcf4\uc774\uc9c0\ub9cc <code>this</code> \ubc14\uc778\ub529\uacfc \ud638\uc774\uc2a4\ud305\uc774 \uac08\ub9ac\uae30 \ub54c\ubb38\uc5d0, \uc0c1\ud669\uc744 \ubcf4\uace0 \uace8\ub77c \uc368\uc57c \ud55c\ub2e4.</p>\n<h3>...</h3>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/10_%EC%9B%B9_%EA%B0%9C%EB%B0%9C_%EB%B0%8F_%EB%B3%B4%EC%95%88/pbkdf2/", "url": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/10_%EC%9B%B9_%EA%B0%9C%EB%B0%9C_%EB%B0%8F_%EB%B3%B4%EC%95%88/pbkdf2/", "title": "PBKDF2 \u2014 \ube44\ubc00\ubc88\ud638 \ud0a4 \uc720\ub3c4 \ud568\uc218", "content_html": "<h1>PBKDF2 \u2014 \ube44\ubc00\ubc88\ud638 \ud0a4 \uc720\ub3c4 \ud568\uc218</h1>\n<h2>\ubc30\uacbd</h2>\n<p>PBKDF2(Password-Based Key Derivation Function 2)\ub294 \ube44\ubc00\ubc88\ud638\ub97c \uc548\uc804\ud558\uac8c \uc800\uc7a5\ud558\ub294 \uc554\ud638\ud654 \ud45c\uc900\uc774\ub2e4. RSA Security\uac00 2000\ub144 RFC 2898\ub85c \ucc98\uc74c \ub0b4\ub1a8\uace0, \uc9c0\uae08\ub3c4 \ub110\ub9ac \uc4f0\uc778\ub2e4....</p>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/10_%EC%9B%B9_%EA%B0%9C%EB%B0%9C_%EB%B0%8F_%EB%B3%B4%EC%95%88/TCP/Socket%20Manage/", "url": "https://gyutory.github.io/YGSTUDY/Language/JavaScript/10_%EC%9B%B9_%EA%B0%9C%EB%B0%9C_%EB%B0%8F_%EB%B3%B4%EC%95%88/TCP/Socket%20Manage/", "title": "Socket Manage", "content_html": "<h1>Socket Manage</h1>\n<h2>\uc18c\ucf13 \uad00\ub9ac\uc758 \ud544\uc694\uc131</h2>\n<p>\ub124\ud2b8\uc6cc\ud06c \uc18c\ucf13\uc740 \uc11c\ubc84\uc640 \ud074\ub77c\uc774\uc5b8\ud2b8\uac00 \ub370\uc774\ud130\ub97c \uc8fc\uace0\ubc1b\ub294 \ud1b5\uc2e0 \ucc44\ub110\uc774\ub2e4. \uc6f9\uc0ac\uc774\ud2b8\uc5d0 \uc811\uc18d\ud560 \ub54c\ub3c4, \ucc44\ud305 \uc571\uc744 \uc4f8 \ub54c\ub3c4, \uac8c\uc784\uc744 \ud560 \ub54c\ub3c4 \uadf8\ub54c\ub9c8\ub2e4 \uc18c\ucf13\uc774 \ub9cc\ub4e4\uc5b4\uc838 \ub370\uc774\ud130\ub97c \uc2e4\uc5b4 \ub098\ub978\ub2e4.</p>\n<p>\uadf8\ub7f0\ub370 \uc774 \uc18c\ucf13\uc744 \uc81c\ub300\ub85c \uc815\ub9ac\ud558\uc9c0 \uc54a\uc73c\uba74 \uc11c...</p>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/Export_Default%EC%99%80_Default_New/", "url": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/Export_Default%EC%99%80_Default_New/", "title": "TypeScript export default\uc640 default new", "content_html": "<h1>TypeScript export default\uc640 default new</h1>\n<h2>\ubc30\uacbd</h2>\n<p>\ubaa8\ub4c8 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ub0b4\ubcf4\ub0b4\uae30(export)\ub294 \ucf54\ub4dc\ub97c \uc7ac\uc0ac\uc6a9 \uac00\ub2a5\ud55c \ub2e8\uc704\ub85c \ub098\ub204\ub294 \ud575\uc2ec \uac1c\ub150\uc774\ub2e4. TypeScript\ub294 ES6 \ubaa8\ub4c8 \uc2dc\uc2a4\ud15c\uc744 \uadf8\ub300\ub85c \uc4f0\uba74\uc11c \ud0c0\uc785 \uc815\ubcf4\ub97c \uc5b9\ub294\ub2e4.</p>\n<h3>export ...</h3>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/tsc%20vs%20ts-node/", "url": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/tsc%20vs%20ts-node/", "title": "tsc\uc640 ts-node\uc758 \ucc28\uc774", "content_html": "<h1>tsc\uc640 ts-node\uc758 \ucc28\uc774</h1>\n<h2>\ubc30\uacbd</h2>\n<p>TypeScript\ub85c \uac1c\ubc1c\ud560 \ub54c \ucf54\ub4dc\ub97c \uc2e4\ud589\ud558\ub294 \ubc29\ubc95\uc740 \ud06c\uac8c \ub450 \uac00\uc9c0\ub2e4. \ud558\ub098\ub294 JavaScript\ub85c \ubcc0\ud658\ud55c \ub4a4 \uc2e4\ud589\ud558\ub294 \ubc29\ubc95(tsc), \ub2e4\ub978 \ud558\ub098\ub294 TypeScript\ub97c \ubc14\ub85c \uc2e4\ud589\ud558\ub294 \ubc29\ubc95(ts-node)\uc774\ub2e4.</p>\n<h3>tsc\uac00 \ud544...</h3>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/%EC%83%9D%EC%84%B1%EC%9E%90/", "url": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/TypeScript%20%EA%B8%B0%EB%B3%B8%20%EA%B0%9C%EB%85%90/%EC%83%9D%EC%84%B1%EC%9E%90/", "title": "TypeScript \uc0dd\uc131\uc790", "content_html": "<h1>TypeScript \uc0dd\uc131\uc790</h1>\n<h2>\uac1c\uc694</h2>\n<p>TypeScript\uc758 \uc0dd\uc131\uc790(Constructor)\ub294 \uac1d\uccb4\uc9c0\ud5a5 \ud504\ub85c\uadf8\ub798\ubc0d\uc758 \ud575\uc2ec \uac1c\ub150\uc774\uc790, \ud074\ub798\uc2a4\uc758 \uc778\uc2a4\ud134\uc2a4\ub97c \ucd08\uae30\ud654\ud558\ub294 \ud2b9\ubcc4\ud55c \uba54\uc11c\ub4dc\ub2e4. \uc774 \ubb38\uc11c\ub294 \uc0dd\uc131\uc790\ub97c \uc2e4\uc81c\ub85c \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\ub294\uc9c0 \ub2e4\ub8ec\ub2e4.</p>\n<h3>\uc0dd\uc131\uc790\uc758 \ubcf8\uc9c8\uc801 \ud2b9\uc131</h3>\n<p>\uc0dd\uc131\uc790\uc5d0\ub294 \uc77c...</p>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Network/7%20Layer/Transport%20Layer/TCP/Mqtt/MQTT/", "url": "https://gyutory.github.io/YGSTUDY/Network/7%20Layer/Transport%20Layer/TCP/Mqtt/MQTT/", "title": "MQTT (Message Queuing Telemetry Transport)", "content_html": "<h1>MQTT (Message Queuing Telemetry Transport)</h1>\n<h2>\ud83d\udccb \ubaa9\ucc28</h2>\n<ul>\n<li><a href=\"#mqtt\ub780-\ubb34\uc5c7\uc778\uac00\">MQTT\ub780 \ubb34\uc5c7\uc778\uac00?</a></li>\n<li><a href=\"#-mqtt\uac00-\ud544\uc694\ud55c-\uc774\uc720\">MQTT\uac00 \ud544\uc694\ud55c \uc774\uc720</a></li>\n<li><a href=\"#mqtt\uc758-\ud575\uc2ec-\uac1c\ub150\">MQTT\uc758 \ud575\uc2ec \uac1c\ub150</a></li>\n<li>[MQTT \uc2dc\uc2a4\ud15c...</li>\n</ul>", "image": null, "date_modified": "2026-08-20T03:30:59+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Standards/Timezone_Handling/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Standards/Timezone_Handling/", "title": "\ud0c0\uc784\uc874 \ucc98\ub9ac", "content_html": "<h1>\ud0c0\uc784\uc874 \ucc98\ub9ac</h1>\n<h2>UTC \uc800\uc7a5 \uc6d0\uce59</h2>\n<p>DB\uc5d0\ub294 UTC\ub9cc \uc800\uc7a5\ud55c\ub2e4. \uc774 \uc6d0\uce59\uc744 \uc5b4\uae30\uba74 \uc11c\ube44\uc2a4\uac00 \uc5ec\ub7ec \uc9c0\uc5ed\uc73c\ub85c \ud655\uc7a5\ub420 \ub54c \ubc18\ub4dc\uc2dc \ubb38\uc81c\uac00 \uc0dd\uae34\ub2e4.</p>\n<p>KST(UTC+9)\ub85c \uc800\uc7a5\ub41c <code>created_at</code>\uc744 \uac16\ub294 \ud14c\uc774\ube14\uc774 \uc788\ub2e4\uace0 \uac00\uc815\ud558\uc790. \ucc98\uc74c\uc5d4 \uad6d\ub0b4 \uc11c\ube44\uc2a4\ub77c \uc544\ubb34 \ubb38\uc81c\uac00 \uc5c6\ub2e4. \ubbf8\uad6d ...</p>", "image": null, "date_modified": "2026-08-20T03:18:04+00:00", "date_published": "2026-07-31T01:08:08+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Standards/UUID_v7/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Standards/UUID_v7/", "title": "UUIDv7", "content_html": "<h1>UUIDv7 \u2014 \ud0c0\uc784\uc2a4\ud0ec\ud504 \uae30\ubc18 UUID\ub85c \uc804\ud658\ud558\ub294 \uc774\uc720\uc640 \ubc29\ubc95</h1>\n<p>UUIDv4\ub97c PK\ub85c \uc4f0\ub2e4\uac00 \ud14c\uc774\ube14\uc5d0 \ub370\uc774\ud130\uac00 \uc218\ucc9c\ub9cc \uac74 \uc313\uc774\uba74 \uc2ac\ub85c\uc6b0 \ucffc\ub9ac\uac00 \ub098\ud0c0\ub098\uae30 \uc2dc\uc791\ud55c\ub2e4. EXPLAIN\uc73c\ub85c \ubcf4\uba74 \uc778\ub371\uc2a4\ub97c \ud0c0\ub294\ub370\ub3c4 \ub290\ub9ac\uace0, SHOW ENGINE INNODB STATUS\uc5d0\uc11c page sp...</p>", "image": null, "date_modified": "2026-08-20T03:18:04+00:00", "date_published": "2026-07-29T02:08:38+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Framework/Node/Abort_Controller/", "url": "https://gyutory.github.io/YGSTUDY/Framework/Node/Abort_Controller/", "title": "AbortController", "content_html": "<h1>AbortController\ub85c \ube44\ub3d9\uae30 \uc791\uc5c5 \ucde8\uc18c\ud558\uae30</h1>\n<p>Node.js\uc5d0\uc11c \ube44\ub3d9\uae30 \uc791\uc5c5\uc744 \uc911\ub2e8\ud558\ub294 \ubb38\uc81c\ub294 \uc624\ub798 \uace8\uce58\ub97c \uc369\uc600\ub2e4. \ud55c\ucc38 \ub3cc\uace0 \uc788\ub294 HTTP \uc694\uccad\uc744 \uc911\uac04\uc5d0 \uba48\ucd9c \ubc29\ubc95\uc774 \uc5c6\uc5b4\uc11c \uc751\ub2f5\uc744 \ubc1b\uace0\ub3c4 \ubc84\ub9ac\uac70\ub098, \ud0c0\uc784\uc544\uc6c3\uc774 \uc9c0\ub09c \ucffc\ub9ac\uac00 \ubc31\uc5d4\ub4dc\uc5d0\uc11c \uacc4\uc18d \ub3cc\uba74\uc11c \ucee4\ub125\uc158\uc744 \uc810\uc720\ud558\ub294 \uc0c1\ud669\uc744...</p>", "image": null, "date_modified": "2026-08-20T03:18:04+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Framework/Node/Permission_Model/", "url": "https://gyutory.github.io/YGSTUDY/Framework/Node/Permission_Model/", "title": "Permission Model", "content_html": "<h1>Node.js Permission Model \uc2ec\ud654</h1>\n<p>\uad8c\ud55c \ubaa8\ub378\uc740 Node 20\uc5d0 <code>--experimental-permission</code> \uc774\ub77c\ub294 \uc774\ub984\uc73c\ub85c \ucc98\uc74c \ub4e4\uc5b4\uc654\uace0, <strong>22\ubd80\ud130 <code>--permission</code> \uc73c\ub85c \uad73\uc5c8\ub2e4.</strong> \uc544\ub798 \uc608\uc2dc\ub294 22 \uc774\uc0c1 \uae30\uc900\uc774\ub77c 20\uc5d0\uc11c \ub530\ub77c \ud558\ub824\uba74 \ud50c\ub798...</p>", "image": null, "date_modified": "2026-08-20T03:18:04+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Framework/Node/%EB%AA%A8%EB%93%88%20%EC%8B%9C%EC%8A%A4%ED%85%9C/CommonJS%20vs%20ESM/", "url": "https://gyutory.github.io/YGSTUDY/Framework/Node/%EB%AA%A8%EB%93%88%20%EC%8B%9C%EC%8A%A4%ED%85%9C/CommonJS%20vs%20ESM/", "title": "CommonJS vs ESM (ECMAScript Modules)", "content_html": "<h1>CommonJS vs ESM</h1>\n<h2>\ubc30\uacbd</h2>\n<p>\ucd08\uae30 JavaScript\uc5d0\ub294 \ubaa8\ub4c8 \uc2dc\uc2a4\ud15c\uc774 \uc5c6\uc5c8\ub2e4. \uc2a4\ud06c\ub9bd\ud2b8\ub97c HTML\uc5d0 \uc21c\uc11c\ub300\ub85c \ub098\uc5f4\ud558\uace0, \ucf54\ub4dc\ub294 \uc804\uc5ed \uc2a4\ucf54\ud504\uc5d0 \uc62c\ub77c\uac14\ub2e4. \ud504\ub85c\uc81d\ud2b8\uac00 \ucee4\uc9c0\uba74 \ubcc0\uc218 \ucda9\ub3cc\uc774 \uc0dd\uae30\uace0, \ub85c\ub529 \uc21c\uc11c \ubb38\uc81c\ub85c \ub7f0\ud0c0\uc784 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\ub2e4.</p>\n<p>Node.js\ub294 2009\ub144...</p>", "image": null, "date_modified": "2026-08-20T03:18:04+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Algorithm/Greedy_Deep_Dive/", "url": "https://gyutory.github.io/YGSTUDY/Algorithm/Greedy_Deep_Dive/", "title": "\uc54c\uace0\ub9ac\uc998 \uc2ec\ud654", "content_html": "<h1>Greedy \uc54c\uace0\ub9ac\uc998 \uc2ec\ud654 (Matroid, \uadfc\uc0ac, \uc628\ub77c\uc778)</h1>\n<h2>\ub4e4\uc5b4\uac00\uba70</h2>\n<p>\uae30\ubcf8 \uadf8\ub9ac\ub514 \ubb38\uc11c\uc5d0\uc11c\ub294 \"\uad50\ud658 \ub17c\uc99d\uc73c\ub85c \uc99d\uba85\ud55c\ub2e4\", \"\ubc18\ub840\ub97c \ucc3e\uc544\ubcf8\ub2e4\" \uac19\uc740 \uc2e4\ubb34 \uac10\uac01 \uc704\uc8fc\ub85c \uc815\ub9ac\ud588\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8 \uc704\uc5d0 \ud55c \uce35 \ub354 \uc313\ub294\ub2e4. \uc65c \uc5b4\ub5a4 \uadf8\ub9ac\ub514\ub294 \ud56d\uc0c1 \ucd5c\uc801\uc774\uace0 \uc5b4\ub5a4 \uadf8\ub9ac\ub514\ub294 \uadfc\uc0ac\ubc16\uc5d0...</p>", "image": null, "date_modified": "2026-08-20T03:14:02+00:00", "date_published": "2026-07-03T07:06:21+00:00", "authors": [], "tags": null}]}