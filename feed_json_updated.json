ct/", "url": "https://gyutory.github.io/YGSTUDY/Language/TypeScript/%ED%83%80%EC%9E%85%20%EB%B0%8F%20%ED%83%80%EC%9E%85%20%EC%A0%95%EC%9D%98/Other%20Types/object/", "title": "TypeScript object \ud0c0\uc785", "content_html": "<h1>TypeScript object \ud0c0\uc785</h1>\n<h2>\ubc30\uacbd</h2>\n<p>TypeScript \uc758 <code>object</code> \ud0c0\uc785\uc740 \ubaa8\ub4e0 \uac1d\uccb4 \uc720\ud615\uc744 \ud3ec\ud568\ud558\ub294 \uc77c\ubc18 \uac1d\uccb4 \ud0c0\uc785\uc774\ub2e4.</p>\n<h3>object \ud0c0\uc785\uc758 \ud544\uc694\uc131</h3>\n<ul>\n<li>\uc77c\ubc18\uc801\uc778 \uac1d\uccb4 \ucc98\ub9ac: \uad6c\uccb4\uc801\uc778 \uad6c\uc870\ub97c \uc54c \uc218 \uc5c6\ub294 \uac1d\uccb4\ub97c \ub2e4\ub8f0 \ub54c</li>\n<li>\ub3d9\uc801 \uac1d\uccb4: \ub7f0\ud0c0\uc784\uc5d0 \uad6c...</li>\n</ul>", "image": null, "date_modified": "2026-08-20T04:00:53+00:00", "date_published": "2026-08-02T03:20:33+00:00", "authors": [], "tags": null}]}