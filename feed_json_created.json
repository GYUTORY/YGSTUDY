\uc774 \uc8fc\uc81c\ub294 \ub9b4\ub9ac\uc2a4 \uc8fc\uae30\uac00 \ube60\ub985\ub2c8\ub2e4. \ucd5c\uc885 \ud655\uc778: **&lt;span class=\"git-revision-date-localized-plugin git-revision-date-localized-plugin-date\" title=\"2026...</p>", "image": null, "date_modified": "2026-10-19T13:49:04+00:00", "date_published": "2026-10-19T13:49:04+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ_Security_And_Maintenance/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ_Security_And_Maintenance/", "title": "Amazon MQ \ubcf4\uc548\uacfc \uc720\uc9c0\ubcf4\uc218 \uc6b4\uc601", "content_html": "<h1>Amazon MQ \ubcf4\uc548\uacfc \uc720\uc9c0\ubcf4\uc218 \uc6b4\uc601</h1>\n<p><a href=\"Amazon_MQ.md\">Amazon MQ \uc6b4\uc601 \ub178\ud2b8</a>\ub294 ENI\uc640 \ubcf4\uc548 \uadf8\ub8f9\uae4c\uc9c0\ub9cc \ub2e4\ub8ec\ub2e4. \ub124\ud2b8\uc6cc\ud06c\ub97c \ub2eb\uc740 \ub4a4\uc5d0\ub3c4 \ud574\uacb0\ud560 \uc77c\uc774 \ub0a8\uc544 \uc788\ub2e4. \ube0c\ub85c\ucee4 \uacc4\uc815\uacfc \ube44\ubc00\ubc88\ud638\ub97c \uc5b4\ub514\uc5d0 \ub450\ub294\uc9c0, \uc804\uc1a1\uacfc \uc800\uc7a5 \uad6c\uac04\uc774 \uc5b4\ub5bb\uac8c \uc554\ud638\ud654\ub418\ub294\uc9c0, \ub85c\uadf8\uac00 \uc5b4\ub514\ub85c...</p>", "image": null, "date_modified": "2026-10-19T10:07:41+00:00", "date_published": "2026-10-19T10:07:41+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ_Active_MQ_Operations/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Application_Integration/Amazon_MQ_Active_MQ_Operations/", "title": "Amazon MQ for ActiveMQ \uc6b4\uc601 \ub178\ud2b8", "content_html": "<h1>Amazon MQ for ActiveMQ \uc6b4\uc601 \ub178\ud2b8</h1>\n<p><a href=\"Amazon_MQ.md\">Amazon MQ \uc6b4\uc601 \ub178\ud2b8</a>\ub294 RabbitMQ \uc911\uc2ec\uc774\uace0 ActiveMQ\ub294 \"active/standby \ud398\uc77c\uc624\ubc84\uc5d0 \uc218\uc2ed \ucd08\uc5d0\uc11c \ubd84 \ub2e8\uc704\uac00 \uac78\ub9b0\ub2e4\"\ub294 \ud55c \ub2e8\ub77d\uc774 \uc804\ubd80\ub2e4. \uc2e4\uc81c\ub85c ActiveMQ \ube0c\ub85c\ucee4...</p>", "image": null, "date_modified": "2026-10-19T09:50:53+00:00", "date_published": "2026-10-19T09:50:53+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Linux_Capabilities_Seccomp_App_Armor/", "url": "https://gyutory.github.io/YGSTUDY/Security/Linux_Capabilities_Seccomp_App_Armor/", "title": "Capabilities\u00b7Seccomp\u00b7AppArmor", "content_html": "<h1>Linux Capabilities, Seccomp, AppArmor</h1>\n<p><a href=\"Container_Escape.md\">\ucee8\ud14c\uc774\ub108 \ud0c8\ucd9c</a>\uc5d0\uc11c <code>--cap-drop=ALL</code>, <code>seccomp=unconfined</code> \uac19\uc740 \uc635\uc158\uc744 \ud55c \uc904\uc529\ub9cc \uc5b8\uae09\ud588\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8 \uc635\uc158 \ub4a4\uc5d0 \uc788\ub294 \uc138 \uc7a5\uce58\uac00 sy...</p>", "image": null, "date_modified": "2026-10-16T04:25:17+00:00", "date_published": "2026-10-16T04:25:17+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Cost/Savings_Plans_Commitment_Portfolio/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Cost/Savings_Plans_Commitment_Portfolio/", "title": "Savings Plans \uc57d\uc815 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \uc6b4\uc601", "content_html": "<h1>Savings Plans \uc57d\uc815 \ud3ec\ud2b8\ud3f4\ub9ac\uc624 \uc6b4\uc601</h1>\n<p>\uc57d\uc815 \ud55c \uac74\uc744 \uc0ac\ub294 \ubc29\ubc95\uc740 <a href=\"Savings_Plans.md\">AWS Savings Plans</a>\uc5d0 \uc815\ub9ac\ud588\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8\ub2e4\uc74c \ub2e8\uacc4\ub97c \ub2e4\ub8ec\ub2e4. \uc57d\uc815\uc774 \ub450 \uac74, \uc5f4 \uac74\uc73c\ub85c \ub298\uc5b4\ub098\uba74 \ubb38\uc81c\uac00 \ubc14\ub010\ub2e4. \ud55c \uac74\uc77c \ub54c\ub294 \uae08\uc561\ub9cc \ub9de\uc73c\uba74 \ub410\uc9c0\ub9cc,...</p>", "image": null, "date_modified": "2026-10-15T03:14:09+00:00", "date_published": "2026-10-15T03:14:09+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Cost/Database_Savings_Plans/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Cost/Database_Savings_Plans/", "title": "Database Savings Plans", "content_html": "<h1>Database Savings Plans</h1>\n<p>2025\ub144 12\uc6d4\uc5d0 \ub098\uc628 DB \uc804\uc6a9 \uc57d\uc815 \uc694\uae08\uc81c\ub2e4. \uc2dc\uac04\ub2f9 \uae08\uc561($/hour)\uc744 1\ub144 \ub3d9\uc548 \uc57d\uc815\ud558\uba74 Aurora, RDS, DynamoDB, ElastiCache \uac19\uc740 DB \uc0ac\uc6a9\ub7c9\uc5d0 \ud560\uc778\uc774 \ubd99\ub294\ub2e4. \uacf5\uc2dd \ubc1c\ud45c\uc5d0 \ub098\uc628 \ud560\uc778 \uc0c1\ud55c\uc740 \uc11c\ubc84\ub9ac...</p>", "image": null, "date_modified": "2026-10-15T03:00:29+00:00", "date_published": "2026-10-15T03:00:29+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Resilience/Hedged_Requests_g_RPC_Envoy_Config/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Resilience/Hedged_Requests_g_RPC_Envoy_Config/", "title": "\ud5e4\uc9c0 \uc694\uccad \uc124\uc815 (gRPC \u00b7 Envoy)", "content_html": "<h1>\ud5e4\uc9c0 \uc694\uccad\uc744 gRPC\uc640 Envoy \uc124\uc815\uc73c\ub85c \ucf1c\uae30</h1>\n<p><a href=\"Hedged_Requests.md\">\ud5e4\uc9c0 \uc694\uccad</a> \ubb38\uc11c\ub294 \uac1c\ub150\uacfc \uc2dc\ubbac\ub808\uc774\uc158\uc744 \ub2e4\ub8ec\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8 \ub2e4\uc74c \ub2e8\uacc4, \uc2e4\uc81c \uc778\ud504\ub77c\uc5d0\uc11c \ud5e4\uc9c0\ub97c \ucf1c\ub294 \uc124\uc815\uacfc \uadf8 \uc124\uc815\uc774 \uc5b4\ub514\uc11c \uae30\ub300\uc640 \ub2e4\ub974\uac8c \uc6c0\uc9c1\uc774\ub294\uc9c0\ub97c \ub2e4\ub8ec\ub2e4. \uc124\uc815 \ud544\ub4dc \uc774\ub984\uc740 \ubb38\uc11c\uc5d0 ...</p>", "image": null, "date_modified": "2026-10-14T13:50:35+00:00", "date_published": "2026-10-14T13:50:35+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/DevOps/Load_Balancer/Envoy_Filter_Chain_and_Threading/", "url": "https://gyutory.github.io/YGSTUDY/DevOps/Load_Balancer/Envoy_Filter_Chain_and_Threading/", "title": "Envoy \ud544\ud130 \uccb4\uc778\uacfc \uc2a4\ub808\ub4dc \ubaa8\ub378", "content_html": "<h1>Envoy \ud544\ud130 \uccb4\uc778\uacfc \uc2a4\ub808\ub4dc \ubaa8\ub378</h1>\n<p><a href=\"Envoy.md\">Envoy \uae30\ubcf8 \ubb38\uc11c</a>\uc5d0\uc11c listener, route, cluster\uc758 \uad00\uacc4\ub294 \ud55c \ubc88 \ud6d1\uc5c8\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8\uc911 \ud544\ud130\uac00 \ub3c4\ub294 \uad6c\uac04\ub9cc \uae4a\uac8c \ud310\ub2e4. \uc6b4\uc601\ud558\ub2e4 \ubcf4\uba74 \uc7a5\uc560\uc758 \uc0c1\ub2f9\uc218\uac00 \uc774 \uad6c\uac04\uc5d0\uc11c \ub098\uc628\ub2e4. \uc778\uc99d\uc774 \uc548 \ub41c \uc694\uccad\uc774 \ucffc...</p>", "image": null, "date_modified": "2026-10-14T12:44:56+00:00", "date_published": "2026-10-14T12:44:56+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Load_Balancer/NLB_Hairpin/", "url": "https://gyutory.github.io/YGSTUDY/Cloud/AWS/Load_Balancer/NLB_Hairpin/", "title": "NLB \ud5e4\uc5b4\ud540 - \ud0c0\uac9f\uc774 \uc790\uae30 NLB\ub85c \uc811\uc18d\ud560 \ub54c", "content_html": "<h1>NLB \ud5e4\uc5b4\ud540 - \ud0c0\uac9f\uc774 \uc790\uae30 NLB\ub85c \uc811\uc18d\ud560 \ub54c</h1>\n<p>NLB \ub4a4\uc5d0 \uc788\ub294 \uc11c\ubc84\uac00 \uac19\uc740 NLB\uc758 DNS \uc774\ub984\uc73c\ub85c \ud638\ucd9c\uc744 \ubcf4\ub0b4\ub294 \uad6c\uc131\uc774 \uc788\ub2e4. \uc11c\ube44\uc2a4 \uac04 \ud638\ucd9c \uc8fc\uc18c\ub97c \ud558\ub098\ub85c \ud1b5\uc77c\ud558\ub824\uace0 \ubaa8\ub4e0 \ud638\ucd9c\uc744 NLB \uc8fc\uc18c\ub85c \uc4f0\ub2e4 \ubcf4\uba74 \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc0dd\uae34\ub2e4. \ub300\ubd80\ubd84\uc758 \ud638\ucd9c\uc740 \uba40\uca61\ud558\uac8c \ub3cc\ub2e4\uac00 \uc5b4\ub290 \uc21c\uac04 ...</p>", "image": null, "date_modified": "2026-10-12T11:08:04+00:00", "date_published": "2026-10-12T11:08:04+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Container_Escape_CVE_Case_Studies/", "url": "https://gyutory.github.io/YGSTUDY/Security/Container_Escape_CVE_Case_Studies/", "title": "\ucee8\ud14c\uc774\ub108 \ud0c8\ucd9c CVE \uc0ac\ub840 \ubd84\uc11d", "content_html": "<h1>\ucee8\ud14c\uc774\ub108 \ud0c8\ucd9c CVE \uc0ac\ub840 \ubd84\uc11d</h1>\n<h2>\ud328\uce58 \ubc88\ud638\ubcf4\ub2e4 \uba3c\uc800 \ubcfc \uac83\uc740 \uae68\uc9c4 \uac00\uc815\uc774\ub2e4</h2>\n<p>runc \ubcf4\uc548 \uacf5\uc9c0\uac00 \ub730 \ub54c\ub9c8\ub2e4 \"\ubc84\uc804 \uc62c\ub9ac\uc138\uc694\"\ub85c \ub05d\ub098\uba74, \ub2e4\uc74c \uacf5\uc9c0 \ub54c \uac19\uc740 \uc9c8\ubb38\uc744 \ucc98\uc74c\ubd80\ud130 \ub2e4\uc2dc \ud55c\ub2e4. \uc6b0\ub9ac \ud074\ub7ec\uc2a4\ud130\uac00 \ub178\ucd9c\ub418\ub294\uc9c0, \ud328\uce58\uac00 \ub178\ub4dc \uc804\uccb4\uc5d0 \ub3c4\ub294 \uba70\uce60 \ub3d9\uc548 \ubb34\uc5c7\uc73c\ub85c \ubc84\ud2f8\uc9c0\ub294 \uadf8...</p>", "image": null, "date_modified": "2026-10-12T02:35:55+00:00", "date_published": "2026-10-12T02:35:55+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Sandboxed_Container_Runtimes_g_Visor_Kata/", "url": "https://gyutory.github.io/YGSTUDY/Security/Sandboxed_Container_Runtimes_g_Visor_Kata/", "title": "\uc0cc\ub4dc\ubc15\uc2a4 \ub7f0\ud0c0\uc784 gVisor\u00b7Kata", "content_html": "<h1>\uc0cc\ub4dc\ubc15\uc2a4 \ucee8\ud14c\uc774\ub108 \ub7f0\ud0c0\uc784 gVisor\u00b7Kata\u00b7Firecracker</h1>\n<h2>\uc124\uc815\uc73c\ub85c \ub9c9\uc744 \uc218 \uc5c6\ub294 \uac83\uc774 \ub0a8\uc544 \uc788\ub2e4</h2>\n<p><a href=\"Container_Escape_CVE_Case_Studies.md\">\ucee8\ud14c\uc774\ub108 \ud0c8\ucd9c CVE \uc0ac\ub840 \ubd84\uc11d</a>\uc5d0\uc11c Dirty Pipe(CVE-2022-0847)\ub294 sec...</p>", "image": null, "date_modified": "2026-10-12T02:35:55+00:00", "date_published": "2026-10-12T02:35:55+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Container_Escape/", "url": "https://gyutory.github.io/YGSTUDY/Security/Container_Escape/", "title": "\ucee8\ud14c\uc774\ub108 \ud0c8\ucd9c(Container Escape)", "content_html": "<h1>Container Escape</h1>\n<h2>\ucee8\ud14c\uc774\ub108\ub294 \uaca9\ub9ac \uc7a5\uce58\uac00 \uc544\ub2c8\ub2e4</h2>\n<p>\ucee8\ud14c\uc774\ub108\ub294 \uac00\uc0c1\uba38\uc2e0\uc774 \uc544\ub2c8\ub2e4. \ud638\uc2a4\ud2b8 \ucee4\ub110\uc744 \uadf8\ub300\ub85c \uacf5\uc720\ud558\uace0, \ud504\ub85c\uc138\uc2a4\u00b7\ub124\ud2b8\uc6cc\ud06c\u00b7\ud30c\uc77c\uc2dc\uc2a4\ud15c <strong>\ubdf0</strong>\ub9cc \ub124\uc784\uc2a4\ud398\uc774\uc2a4\ub85c \uac08\ub77c\ub193\uc740 \uc77c\ubc18 \ud504\ub85c\uc138\uc2a4\ub2e4. \uadf8 \ubdf0\ub97c \uc720\uc9c0\ud558\ub294 \uac74 \ucee4\ub110\uc758 \uc138 \uac00\uc9c0 \uc7a5\uce58\ub2e4.</p>\n<ul>\n<li>**\ub124\uc784\uc2a4\ud398...</li>\n</ul>", "image": null, "date_modified": "2026-10-10T14:10:23+00:00", "date_published": "2026-10-10T14:10:23+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/GitHub_Actions_Workflow_Injection/", "url": "https://gyutory.github.io/YGSTUDY/Security/GitHub_Actions_Workflow_Injection/", "title": "GitHub Actions \uc6cc\ud06c\ud50c\ub85c \uc778\uc81d\uc158", "content_html": "<h1>GitHub Actions \uc6cc\ud06c\ud50c\ub85c \uc778\uc81d\uc158</h1>\n<h2>\uc65c YAML \ud55c \uc904\uc774 \uba85\ub839 \uc2e4\ud589\uc774 \ub418\ub294\uac00</h2>\n<p>GitHub Actions\uc758 \uc6cc\ud06c\ud50c\ub85c\ub294 \uc2e4\ud589 \uc804\uc5d0 <code>${{ }}</code> \ud45c\ud604\uc2dd\uc744 <strong>\ubb38\uc790\uc5f4 \uce58\ud658</strong>\uc73c\ub85c \uba3c\uc800 \ud3bc\uce5c\ub2e4. \uc258 \uc2a4\ud06c\ub9bd\ud2b8\ub97c \uc2e4\ud589\ud558\ub294 <code>run:</code> \ube14\ub85d \uc548\uc5d0 <code>${{ }}</code>\ub97c \uc4f0\uba74, ...</p>", "image": null, "date_modified": "2026-10-10T14:10:23+00:00", "date_published": "2026-10-10T14:10:23+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Algorithm/Binary_Search_Patterns/", "url": "https://gyutory.github.io/YGSTUDY/Algorithm/Binary_Search_Patterns/", "title": "Binary Search \ud328\ud134", "content_html": "<h1>Binary Search \ud328\ud134</h1>\n<p><a href=\"Binary_Search.md\">Binary Search</a>\uc5d0\uc11c \uae30\ubcf8 \uad6c\ud604, lower_bound/upper_bound, \ud30c\ub77c\uba54\ud2b8\ub9ad \uc11c\uce58\uc758 \uace8\uaca9, \uacbd\uacc4 \uc2e4\uc218\ub97c \ub2e4\ub918\ub2e4. \uc774 \ubb38\uc11c\ub294 \uadf8 \uc704\uc5d0\uc11c \uc790\uc8fc \ub9c8\uc8fc\uce58\ub294 \ubcc0\ud615\ub9cc \ubaa8\uc558\ub2e4. \ud68c\uc804 \ubc30\uc5f4, \ud310\uc815 \ubc29\ud5a5\uc774 ...</p>", "image": null, "date_modified": "2026-10-10T13:21:21+00:00", "date_published": "2026-10-10T13:21:21+00:00", "authors": [], "tags": null}]}