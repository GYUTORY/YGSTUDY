 Origin Shield)</h1>\n<p>CDN\uc744 \ubd99\uc774\uace0 \uc5e3\uc9c0 \ud788\ud2b8\uc728 \ub300\uc2dc\ubcf4\ub4dc\uac00 80%\ub97c \ub118\uc73c\uba74 \uc624\ub9ac\uc9c4 \ubd80\ud558 \ubb38\uc81c\ub294 \ub05d\ub0ac\ub2e4\uace0 \uc0dd\uac01\ud558\uae30 \uc27d\ub2e4. \uadf8\ub7f0\ub370 \uc624\ub9ac\uc9c4 \uc811\uc18d \ub85c\uadf8\ub97c \uc5f4...</p>", "image": null, "date_modified": "2026-10-02T00:59:42+00:00", "date_published": "2026-10-02T00:59:42+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/CI_CD_Pipeline_Attacks/", "url": "https://gyutory.github.io/YGSTUDY/Security/CI_CD_Pipeline_Attacks/", "title": "CI/CD \ud30c\uc774\ud504\ub77c\uc778 \uacf5\uaca9", "content_html": "<h1>CI/CD \ud30c\uc774\ud504\ub77c\uc778 \uacf5\uaca9</h1>\n<p>CI \ub7ec\ub108\ub294 \uc11c\ube44\uc2a4\uc5d0\uc11c \uac00\uc7a5 \ub9ce\uc740 \uad8c\ud55c\uc774 \ud55c\uacf3\uc5d0 \ubaa8\uc774\ub294 \uc7a5\ube44\ub2e4. \ud074\ub77c\uc6b0\ub4dc \ubc30\ud3ec \ud0a4, \ub808\uc9c0\uc2a4\ud2b8\ub9ac \ubc1c\ud589 \ud1a0\ud070, \uc800\uc7a5\uc18c \uc4f0\uae30\uc6a9 PAT\uac00 \ud658\uacbd \ubcc0\uc218\ub85c \ub4e4\uc5b4\uc624\uace0, \uadf8 \uc704\uc5d0\uc11c \ub0b4\uac00 \uc4f0\uc9c0\ub3c4 \uc54a\uc740 \ub0a8\uc758 \ucf54\ub4dc(\uc11c\ub4dc\ud30c\ud2f0 \uc561\uc158, npm \ud328\ud0a4\uc9c0\uc758 \uc124\uce58 \uc2a4\ud06c\ub9bd\ud2b8)\uac00 \uac19\uc740 ...</p>", "image": null, "date_modified": "2026-10-02T00:59:42+00:00", "date_published": "2026-10-02T00:59:42+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Credential_Stuffing/", "url": "https://gyutory.github.io/YGSTUDY/Security/Credential_Stuffing/", "title": "\ud06c\ub9ac\ub374\uc158 \uc2a4\ud130\ud551", "content_html": "<h1>\ud06c\ub9ac\ub374\uc158 \uc2a4\ud130\ud551</h1>\n<p>\uc0c8\ubcbd 3\uc2dc\uc5d0 \ub85c\uadf8\uc778 \uc2e4\ud328\uc728 \uc54c\ub78c\uc774 \uc6b8\ub838\ub2e4. \ud3c9\uc18c 95% \uadfc\ucc98\uc774\ub358 \ub85c\uadf8\uc778 \uc131\uacf5\ub960\uc774 1~3%\ub300\ub85c \ub0b4\ub824\uac00 \uc788\uc5c8\uace0, \uacc4\uc815 \uc7a0\uae08 \uce74\uc6b4\ud130\ub294 \ud55c \ubc88\ub3c4 \uc62c\ub77c\uac00\uc9c0 \uc54a\uc558\ub2e4. \uacc4\uc815\ubcc4 \uc2e4\ud328 \ud69f\uc218\ub97c \uc138\ub294 \ubc29\uc5b4\ub294 \uadf8\ub300\ub85c\uc600\ub294\ub370 \uacf5\uaca9\uc740 \uadf8 \ubc11\uc73c\ub85c \uc9c0\ub098\uac00\uace0 \uc788\uc5c8\ub2e4. \uadf8\ub0a0 \uc774\ud6c4 \ub85c\uadf8\uc778 \ubc29\uc5b4\ub97c...</p>", "image": null, "date_modified": "2026-10-02T00:59:42+00:00", "date_published": "2026-10-02T00:59:42+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Security/Deepfake_and_AI_Fraud/", "url": "https://gyutory.github.io/YGSTUDY/Security/Deepfake_and_AI_Fraud/", "title": "\ub525\ud398\uc774\ud06c\uc640 AI \uc0ac\uae30", "content_html": "<h1>\ub525\ud398\uc774\ud06c\uc640 AI \uc0ac\uae30</h1>\n<p><a href=\"AI_for_Security.md\">AI\ub85c \ubcf4\uc548 \uac15\ud654\ud558\uae30</a>\ub294 \ubc29\uc5b4\ud558\ub294 \ucabd\uc774 LLM\uc744 \uc5b4\ub514\uc5d0 \ub123\uace0 \uc5b4\ub514\uc5d0 \ub123\uc9c0 \ub9d0\uc544\uc57c \ud558\ub294\uc9c0\ub97c \ub2e4\ub8ec\ub2e4. \uc774 \ubb38\uc11c\ub294 \ubc18\ub300\ud3b8, \uacf5\uaca9\uc790\uac00 AI\ub97c \uc4f0\uae30 \uc2dc\uc791\ud558\uba74\uc11c \uc11c\ube44\uc2a4 \uc6b4\uc601\uc790\uac00 \uc2e4\uc81c\ub85c \ub9c8\uc8fc\uce58\ub294 \uc0ac\uae30 \uc720\ud615\uc744 \ub2e4\ub8ec\ub2e4. \uc0c8\ub85c\uc6b4 \ucde8\uc57d\uc810...</p>", "image": null, "date_modified": "2026-10-02T00:59:42+00:00", "date_published": "2026-10-02T00:59:42+00:00", "authors": [], "tags": null}]}