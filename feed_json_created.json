c815\ub41c \ubb38\uc11c\uc785\ub2c8\ub2e4. \ube4c\ub4dc \uc2dc\uc810\uc5d0 \uc790\ub3d9 \uc0dd\uc131\ub429\ub2c8\ub2e4.</p>\n<p>| \ub0a0\uc9dc | \ubb38\uc11c |\n|------|------|\n| 2026-08-18 | <a href=\"Backend/Caching/index.md\">Caching \uc804\uccb4 \ubcf4\uae30</a> |\n| 2026-08-18 | [A...</p>", "image": null, "date_modified": "2026-08-18T06:35:13.000668+00:00", "date_published": "2026-08-18T06:35:13.000660+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Caching/Redis_%EC%9A%B4%EC%98%81/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Caching/Redis_%EC%9A%B4%EC%98%81/", "title": "Redis \uc6b4\uc601", "content_html": "<h1>Redis \uc6b4\uc601</h1>\n<h2>Persistence \u2014 RDB\uc640 AOF</h2>\n<p>Redis\ub294 \uba54\ubaa8\ub9ac \ub370\uc774\ud130\ubca0\uc774\uc2a4\ub77c\uc11c \ud504\ub85c\uc138\uc2a4\uac00 \uc8fd\uc73c\uba74 \ub370\uc774\ud130\uac00 \uc0ac\ub77c\uc9c4\ub2e4. Persistence\ub97c \uc124\uc815\ud558\uba74 \uc7ac\uc2dc\uc791 \ud6c4 \ub514\uc2a4\ud06c\uc5d0\uc11c \ubcf5\uad6c\ud560 \uc218 \uc788\ub2e4.</p>\n<h3>RDB</h3>\n<p>\ud2b9\uc815 \uc2dc\uc810\uc758 \uc2a4\ub0c5\uc0f7\uc744 <code>.rdb</code> \ud30c\uc77c\ub85c \uc800\uc7a5\ud55c\ub2e4...</p>", "image": null, "date_modified": "2026-08-18T01:36:13+00:00", "date_published": "2026-08-18T01:36:13+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/Backend/Caching/%EC%BA%90%EC%8B%9C_%EB%AC%B4%ED%9A%A8%ED%99%94/", "url": "https://gyutory.github.io/YGSTUDY/Backend/Caching/%EC%BA%90%EC%8B%9C_%EB%AC%B4%ED%9A%A8%ED%99%94/", "title": "\uce90\uc2dc \ubb34\ud6a8\ud654", "content_html": "<h2>TTL\uc774 \uc804\ubd80\uac00 \uc544\ub2cc \uc774\uc720</h2>\n<p>\uce90\uc2dc \ubb34\ud6a8\ud654\ub294 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uacf5\ud559\uc5d0\uc11c \uc5b4\ub835\uae30\ub85c \uc720\uba85\ud55c \ubb38\uc81c\ub2e4. Phil Karlton\uc758 \ub9d0\uc744 \ube4c\ub9ac\uba74 \"\ucef4\ud4e8\ud130 \uacfc\ud559\uc5d0\uc11c \uc5b4\ub824\uc6b4 \uac83\uc740 \ub450 \uac00\uc9c0\ubfd0\uc774\ub2e4 \u2014 \uce90\uc2dc \ubb34\ud6a8\ud654\uc640 \uc774\ub984 \uc9d3\uae30.\"</p>\n<p>TTL\uc744 \uc124\uc815\ud558\uba74 \uce90\uc2dc\uac00 \uc790\ub3d9 \ub9cc\ub8cc\ub418\ub2c8 \ucda9\ubd84\ud574 \ubcf4\uc778\ub2e4. \uc2e4\uc81c\ub85c\ub294 \ub450 \uac00\uc9c0...</p>", "image": null, "date_modified": "2026-08-18T01:36:13+00:00", "date_published": "2026-08-18T01:36:13+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/DevOps/Monitoring/Alerting_%EA%B7%9C%EC%B9%99_%EC%84%A4%EA%B3%84/", "url": "https://gyutory.github.io/YGSTUDY/DevOps/Monitoring/Alerting_%EA%B7%9C%EC%B9%99_%EC%84%A4%EA%B3%84/", "title": "\uaddc\uce59 \uc124\uacc4", "content_html": "<h1>Alerting \uaddc\uce59 \uc124\uacc4</h1>\n<p>\uc54c\ub9bc\uc774 \ub9ce\uc73c\uba74 \uc544\ubb34 \uc54c\ub9bc\ub3c4 \uc548 \ubcf4\uc778\ub2e4. \ucc98\uc74c Prometheus + Alertmanager\ub97c \ubd99\uc774\uba74 \"\uc774\uac83\ub3c4, \uc800\uac83\ub3c4\" \ud558\ub2e4\uac00 \uc11d \ub2ec \ub4a4\uc5d0 \uc0c8\ubcbd 3\uc2dc Slack \uc54c\ub9bc\uc744 \uc2b5\uad00\uc801\uc73c\ub85c \ubb34\uc2dc\ud558\ub294 \ud300\uc774 \ub41c\ub2e4. \uc9c4\uc9dc \uc7a5\uc560\uac00 \ub098\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\ub85c \ubb34\uc2dc\ud55c\ub2e4. \uc54c\ub9bc \ud53c\ub85c...</p>", "image": null, "date_modified": "2026-08-16T13:19:41+00:00", "date_published": "2026-08-16T13:19:41+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/DevOps/Monitoring/Loki_%EB%A1%9C%EA%B7%B8_%EC%A7%91%EA%B3%84/", "url": "https://gyutory.github.io/YGSTUDY/DevOps/Monitoring/Loki_%EB%A1%9C%EA%B7%B8_%EC%A7%91%EA%B3%84/", "title": "\ub808\uc774\ube14\u00b7Alloy\u00b7LogQL", "content_html": "<h1>Loki \ub85c\uadf8 \uc9d1\uacc4</h1>\n<p>Loki\ub294 \ub85c\uadf8 \ub0b4\uc6a9\uc744 \uc778\ub371\uc2f1\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub808\uc774\ube14\ub9cc \uc778\ub371\uc2f1\ud558\uace0 \ub0b4\uc6a9\uc740 \uccad\ud06c\ub85c \uc555\ucd95\ud574 \uc624\ube0c\uc81d\ud2b8 \uc2a4\ud1a0\ub9ac\uc9c0\uc5d0 \uc800\uc7a5\ud55c\ub2e4. \ucffc\ub9ac\ud560 \ub54c \uccad\ud06c\ub97c \uc77d\uc5b4 \uac01 \uc904\uc744 \ud544\ud130\ub9c1\ud558\ub294 \ubc29\uc2dd\uc774\ub77c \ud480\ud14d\uc2a4\ud2b8 \uac80\uc0c9 \uc18d\ub3c4\ub294 Elasticsearch\ubcf4\ub2e4 \ub290\ub9ac\uc9c0\ub9cc, \uc800\uc7a5 \ube44\uc6a9\uc774 \ub0ae\uace0 Grafan...</p>", "image": null, "date_modified": "2026-08-16T13:19:41+00:00", "date_published": "2026-08-16T13:19:41+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/%EB%A1%9C%EB%93%9C%EB%A7%B5/%EB%B0%B1%EC%97%94%EB%93%9C_%EC%8B%A0%EC%9E%85_Docker_%EC%9E%85%EB%AC%B8/", "url": "https://gyutory.github.io/YGSTUDY/%EB%A1%9C%EB%93%9C%EB%A7%B5/%EB%B0%B1%EC%97%94%EB%93%9C_%EC%8B%A0%EC%9E%85_Docker_%EC%9E%85%EB%AC%B8/", "title": "\ubc31\uc5d4\ub4dc \uc2e0\uc785 Docker \uc785\ubb38", "content_html": "<h1>\ubc31\uc5d4\ub4dc \uc2e0\uc785 Docker \uc785\ubb38</h1>\n<p>20\uc120 \ub85c\ub4dc\ub9f5\uc5d0\uc11c ECS/Fargate\ub85c \ubc14\ub85c \ub118\uc5b4\uac00\ub294\ub370, \uc2e4\uc81c\ub85c \uadf8 \ubb38\uc11c\ub97c \ucc98\uc74c \uc77d\uc73c\uba74 \"Task Definition\uc774 \ubb54\uc9c0\ub294 \uc54c\uaca0\ub294\ub370 \uc774\ubbf8\uc9c0\ub294 \uc5b4\ub5bb\uac8c \ub9cc\ub4e4\uc8e0?\"\uc5d0\uc11c \ub9c9\ud78c\ub2e4. Docker \uc5c6\uc774 ECS\ub97c \uc774\ud574\ud558\ub824\ub294 \uac74 Jar \uc5c6\uc774 EC2 \ubc30\ud3ec\ub97c ...</p>", "image": null, "date_modified": "2026-08-15T13:32:00+00:00", "date_published": "2026-08-15T13:32:00+00:00", "authors": [], "tags": null}, {"id": "https://gyutory.github.io/YGSTUDY/%EB%A1%9C%EB%93%9C%EB%A7%B5/%EB%B0%B1%EC%97%94%EB%93%9C_%EC%8B%A0%EC%9E%85_%EC%9D%B8%EC%A6%9D_%EC%9D%B8%EA%B0%80_%EA%B8%B0%EC%B4%88/", "url": "https://gyutory.github.io/YGSTUDY/%EB%A1%9C%EB%93%9C%EB%A7%B5/%EB%B0%B1%EC%97%94%EB%93%9C_%EC%8B%A0%EC%9E%85_%EC%9D%B8%EC%A6%9D_%EC%9D%B8%EA%B0%80_%EA%B8%B0%EC%B4%88/", "title": "\ubc31\uc5d4\ub4dc \uc2e0\uc785 \uc778\uc99d/\uc778\uac00 \uae30\ucd08", "content_html": "<h1>\ubc31\uc5d4\ub4dc \uc2e0\uc785 \uc778\