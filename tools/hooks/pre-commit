#!/usr/bin/env python3
"""
pre-commit 훅: 스테이징된 .md 파일의 updated 필드를 오늘 날짜로 자동 갱신 +
NFD 문자 포함 파일 차단.

설치: bash tools/install_hooks.sh
"""

import re
import subprocess
import sys
import unicodedata
from datetime import date
from pathlib import Path

TODAY = date.today().isoformat()
FM_END_RE = re.compile(r'^---\s*$', re.MULTILINE)
UPDATED_RE = re.compile(r'^(updated\s*:\s*).*$', re.MULTILINE)


def get_staged_md_files() -> list[Path]:
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
        capture_output=True, text=True
    )
    return [
        Path(p) for p in result.stdout.splitlines()
        if p.endswith('.md')
    ]


def update_file(path: Path) -> bool:
    """updated 필드 갱신. 변경되었으면 True."""
    try:
        content = path.read_text(encoding='utf-8')
    except Exception:
        return False

    if not content.startswith('---'):
        return False

    matches = list(FM_END_RE.finditer(content, 3))
    if not matches:
        return False

    fm_end = matches[0].end()
    fm = content[3:matches[0].start()]

    if 'updated' in fm:
        new_fm = UPDATED_RE.sub(rf'\g<1>{TODAY}', fm)
    else:
        new_fm = fm.rstrip() + f'\nupdated: {TODAY}\n'

    new_content = '---' + new_fm + '---' + content[fm_end:]
    if new_content == content:
        return False

    path.write_text(new_content, encoding='utf-8')
    return True


def check_nfc(files: list[Path]) -> list[Path]:
    """NFD 문자가 포함된 파일 반환. macOS 에서 한글 경로 입력 시 NFD 로 저장되는 것을 잡는다."""
    bad = []
    for p in files:
        if not p.exists():
            continue
        try:
            text = p.read_text(encoding='utf-8')
        except Exception:
            continue
        if text != unicodedata.normalize('NFC', text):
            bad.append(p)
    return bad


def main():
    files = get_staged_md_files()
    updated = []

    for f in files:
        if not f.exists():
            continue
        if update_file(f):
            subprocess.run(['git', 'add', str(f)])
            updated.append(f)

    if updated:
        print(f'[pre-commit] updated 필드 갱신: {len(updated)}개 파일')
        for f in updated:
            print(f'  {f}')

    nfd_files = check_nfc(files)
    if nfd_files:
        print('[pre-commit] NFD 문자 발견 — NFC 로 정규화 후 커밋하세요:')
        print('  (실행: python3 tools/nfc_normalize.py)')
        for f in nfd_files:
            print(f'  {f}')
        sys.exit(1)

    sys.exit(0)


if __name__ == '__main__':
    main()
